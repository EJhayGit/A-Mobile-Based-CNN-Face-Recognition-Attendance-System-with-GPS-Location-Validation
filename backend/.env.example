# Copy to backend/.env or inject through the host process. The application does
# not read this file automatically and never sends these values to the browser.
DATABASE_URL=
JWT_SECRET=
ENVIRONMENT=development
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
BACKEND_HOST=127.0.0.1
PORT=8080
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_HOURS=168
ACTIVATION_CODE_HOURS=72
ACTIVATION_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
ATTENDANCE_MAX_AGE_DAYS=30
ATTENDANCE_FUTURE_MINUTES=10
MAX_REQUEST_BYTES=65536
ENABLE_API_DOCS=true
